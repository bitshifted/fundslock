# contains envuronment variables for backend service
# copy this file to .env and fill in the values
# ONLY USED FOR DEVELOPMENT PURPOSES. This is not to be used in production deployment

GRAPH_URL=http://somehot.com
GRAPH_API_KEY=dummy-key
JWT_SECRET_KEY=secret_jwt_HMAC_key
ACCESS_TOKEN_DURATION=300 # defaults to 15 minutes if not set
REFRESH_TOKEN_DURATION=3600000 # defaults to 7 days if not set
SECCURE_COOKIE=false # defaults to true if (use secure cookies) is not set. Set to false for local development
COOKIE_DOMAIN=localhost
